{
  "name": "@wyre-ai/node-spanning",
  "version": "1.0.4",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Comprehensive, fully-typed Node.js/TypeScript client library for the Spanning Cloud Backup REST API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "spanning",
    "spanning-backup",
    "saas-backup",
    "m365",
    "google-workspace",
    "salesforce",
    "msp",
    "api",
    "typescript",
    "kaseya"
  ],
  "author": "Aaron Sachs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRE-AI/node-spanning.git"
  },
  "bugs": {
    "url": "https://github.com/WYRE-AI/node-spanning/issues"
  },
  "homepage": "https://github.com/WYRE-AI/node-spanning#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "msw": "^2.15.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
